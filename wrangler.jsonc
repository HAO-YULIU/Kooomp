// Cloudflare Workers 部署設定（《魔蝕milner》）：https://kooomp.noron.workers.dev/
// Worker 名稱要跟 Cloudflare 後台一樣（kooomp），不然自動部署會失敗
// - 網頁：tools/build.mjs 產生 dist/（程式打包、混淆），只發佈 dist/
// - 遊戲 API 與房間：server/worker.mjs、server/room.mjs（Durable Objects，答案只在這裡，不會出現在網頁）
{
  "name": "kooomp",
  "main": "server/worker.mjs",
  "compatibility_date": "2025-10-01",
  "build": {
    "command": "npm ci --prefix tools && node tools/build.mjs"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "vars": {
    "SUPABASE_URL": "https://umlnwzpmjxktfzjvcbts.supabase.co",
    "SUPABASE_KEY": "sb_publishable_8J3VI8dijlCccHQbXPfCQQ_v_O0Au3w"
  }
}
